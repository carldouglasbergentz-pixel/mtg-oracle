# Database — generated from sources
data/mtg.db
data/mtg.db-journal
data/mtg.db-wal
data/mtg.db-shm
# Manual snapshots taken before risky writes
data/backups/

# Bulk source/raw data (downloaded by the sync)
data/raw/

# Forge release (GPL-3, ~300 MB) — an external tool, unpacked locally, never vendored
tools/forge/

# Forge built from the Duel Commander PR branch, staged in the release layout by tools/stage_forge.py: what the app builds against
tools/forge-dc/

# Gradle distribution used once to bootstrap app/'s wrapper (the wrapper itself is tracked)
tools/gradle/

# Maven 3.9.16, for building Forge from source (the Duel Commander PR)
tools/maven/

# JVM app (docs/adr/0001): build output (incl. the copied Forge res/ in
# app/build/forge-assets), Gradle state, Kotlin caches.
app/build/
app/*/build/
app/.gradle/
# installLocal's snapshots: what the user plays (run app/run-mtg-oracle.cmd)
app/dist/
app/.kotlin/
# The app's own data: Forge user data + image cache + settings, and game logs.
data/app/
data/game_logs/

# The retired Python TUI's preferences (its theme is the app's first-start default)
data/config.json

# Forge integration: full sim logs, and the card index cached per Forge version
data/forge_logs/
data/forge_card_index.*

# Exports: deck lists, MTGO files, .mtgoracle packages
data/exports/
# A .mtgoracle package dropped in to be imported: a whole library, the user's own
data/import/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# The maintainer's own notes (the project plan, the deck reports): a private repository of their own.
docs/private/

# Claude Code per-user local settings (project .claude/settings.json IS tracked)
.claude/settings.local.json
# Playmats: the user's own pictures
data/playmats/
