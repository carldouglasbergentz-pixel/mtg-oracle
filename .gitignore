# Database — generated from sources
data/mtg.db
data/mtg.db-journal
data/mtg.db-wal
data/mtg.db-shm
# Manual snapshots taken before risky writes
data/backups/

# Bulk source/raw data (fetched on demand by sync_*.py)
data/raw/

# Forge release (GPL-3, ~300 MB) — an external tool, unpacked locally, never vendored
tools/forge/

# Gradle distribution used once to bootstrap app/'s wrapper (the wrapper itself is tracked)
tools/gradle/

# JVM app (docs/adr/0001): build output, Gradle state, Kotlin caches. The Forge
# sandbox (redirected APPDATA, copied decks) and game logs live under app/build/.
app/build/
app/.gradle/
app/.kotlin/

# User preferences (theme, etc.) — per-machine, not source
data/config.json

# Forge integration: full sim logs, and the card index cached per Forge version
data/forge_logs/
data/forge_card_index.*

# Generated spreadsheets / dumps from scripts/export_*.py
data/exports/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Claude Code per-user local settings (project .claude/settings.json IS tracked)
.claude/settings.local.json
